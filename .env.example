# ---------------------------------------------------------------------------
# Alfa-Kurs — environment template
# Copy to .env and fill real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=alfakurs
POSTGRES_PASSWORD=change_me
POSTGRES_DB=alfakurs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async/sync SQLAlchemy URL used by the backend
DATABASE_URL=postgresql+psycopg://alfakurs:change_me@localhost:5432/alfakurs

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ML: retrieval ----------------------------------------------------------
# tfidf | embedding
RETRIEVER=tfidf
RETRIEVAL_K=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ML: LinUCB -------------------------------------------------------------
# Exploration strength. Larger = more exploration.
LINUCB_ALPHA=1.0
# Ridge term keeping A positive definite.
LINUCB_RIDGE=0.01
# Directory for saved model artifacts.
MODEL_DIR=artifacts

# --- ML: reward weights -----------------------------------------------------
REWARD_CLICK=1.0
REWARD_INSPECT=1.0
REWARD_PURCHASE=10.0

# --- Experiments ------------------------------------------------------------
EXPERIMENT_SEEDS=5
EXPERIMENT_USERS=200
EXPERIMENT_ROUNDS=50
EXPERIMENT_SEED_BASE=42

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
